[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://ui/components/app_onboarding_hero_card.gd" id="1_script"]
[ext_resource type="PackedScene" path="res://ui/components/AppButton.tscn" id="2_button"]

[node name="OnboardingHeroCard" type="PanelContainer"]
size_flags_horizontal = 3
script = ExtResource("1_script")

[node name="Layout" type="VBoxContainer" parent="."]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 16

[node name="EyebrowLabel" type="Label" parent="Layout"]
unique_name_in_owner = true
layout_mode = 2
text = "SECTION"

[node name="TitleLabel" type="Label" parent="Layout"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"LabelDisplayHero"
autowrap_mode = 3
text = "Titre principal"

[node name="DescriptionLabel" type="Label" parent="Layout"]
unique_name_in_owner = true
layout_mode = 2
autowrap_mode = 3
text = "Le monde devient instable et les héros manquent de préparation."

[node name="ActionsRow" type="HBoxContainer" parent="Layout"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="CTAButton" parent="Layout/ActionsRow" instance=ExtResource("2_button")]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
label_text = "ACTION PRINCIPALE"

[node name="LoginRow" type="HBoxContainer" parent="Layout"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="AlreadyLabel" type="Label" parent="Layout/LoginRow"]
unique_name_in_owner = true
layout_mode = 2
text = "Déjà étudiant ?"

[node name="LoginLink" type="LinkButton" parent="Layout/LoginRow"]
unique_name_in_owner = true
layout_mode = 2
text = "Action secondaire"

[node name="RewardsGrid" type="GridContainer" parent="Layout"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
columns = 2
theme_override_constants/h_separation = 8
theme_override_constants/v_separation = 8
